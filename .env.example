NEXT_PUBLIC_ASSET_BASE_URL="change-me-to-your-asset-base-url"
NEXT_PUBLIC_FORMSPREE_ID="change-me-to-your-formspree-id"
GEMINI_API_KEY="change-me-to-your-gemini-api-key"# Branch and repo the CMS at /admin commits to. Defaults to the branch Vercel
# deployed (VERCEL_GIT_COMMIT_REF), else main.
CMS_GITHUB_BRANCH="main"
CMS_GITHUB_REPO="nguyentin082/MusicBrandLandingPage"
# R2 credentials for app/api/cms/upload (images pasted into the CMS). Use a
# separate R2 API token with Object Read & Write on this bucket only.
R2_ACCOUNT_ID="change-me"
R2_BUCKET="music-landing-page"
R2_ACCESS_KEY_ID="change-me"
R2_SECRET_ACCESS_KEY="change-me"
